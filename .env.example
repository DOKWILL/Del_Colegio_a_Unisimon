# ==============================================
# Configuración del Sistema de Gestión Académica
# "Del Colegio a la Unisimón"
# ==============================================

# Django Secret Key (generar una nueva para producción)
SECRET_KEY=django-insecure-change-this-to-a-real-secret-key

# Debug mode (False en producción)
DEBUG=True

# Hosts permitidos (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos
# Para SQLite (desarrollo):
DATABASE_URL=sqlite:///db.sqlite3

# Para PostgreSQL (producción):
# DATABASE_URL=postgres://usuario:contraseña@localhost:5432/colegio_unisimon

# Nota mínima aprobatoria (configurable)
NOTA_MINIMA_APROBATORIA=3.0
